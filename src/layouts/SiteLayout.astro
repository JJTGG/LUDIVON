---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "LUDIVON — Gaming & Technology Guides",
  description = "Understand your tech. Play smarter. Practical Android gaming and game-specific guides."
} = Astro.props;

const indexingEnabled =
  import.meta.env.PUBLIC_INDEXING_ENABLED === "true";

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;

const robotsContent = indexingEnabled
  ? "index, follow"
  : "noindex, nofollow";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />

    <meta name="theme-color" content="#F7F8FA" />

    <meta property="og:site_name" content="LUDIVON" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    {canonicalUrl && (
      <link rel="canonical" href={canonicalUrl} />
    )}

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>

    <SiteHeader />

    <main id="main-content">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>