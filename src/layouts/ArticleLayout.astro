---
import { getEntry } from "astro:content";
import SiteLayout from "./SiteLayout.astro";
import type { ArticleEntry } from "../lib/related-articles";

interface ArticleHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: ArticleEntry;
  headings: ArticleHeading[];
  relatedArticles: ArticleEntry[];
}

const {
  entry,
  headings,
  relatedArticles
} = Astro.props;

const article = entry.data;

const author = await getEntry(article.authorId);

if (!author || author.data.status !== "published") {
  throw new Error(
    `Published article "${entry.id}" must reference an existing published author record.`
  );
}

const formatDate = (date: Date) =>
  date.toLocaleDateString("en", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC"
  });

const formatLabel = (value: string) =>
  value
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");

const readingText = (entry.body ?? "")
  .replace(/```[\s\S]*?```/g, " ")
  .replace(/`[^`]*`/g, " ")
  .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
  .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
  .replace(/<[^>]*>/g, " ")
  .replace(/[#>*_~|]/g, " ")
  .replace(/\s+/g, " ")
  .trim();

const wordCount = readingText
  ? readingText.split(" ").filter(Boolean).length
  : 0;

const readingTimeMinutes = Math.max(1, Math.ceil(wordCount / 220));

const sectionTitle =
  article.section === "android-gaming"
    ? "Android Gaming"
    : "Game Guides";

const tableOfContentsHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3
);

const levelTwoHeadingCount = headings.filter(
  (heading) => heading.depth === 2
).length;

const showTableOfContents = levelTwoHeadingCount >= 3;
---

<SiteLayout
  title={`${article.title} | LUDIVON`}
  description={article.description}
>
  <article class="article-shell shell">
    <nav class="article-breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li>
          <a href="/">Home</a>
        </li>

        <li>
          <a href={`/${article.section}/`}>{sectionTitle}</a>
        </li>

        <li>
          <span aria-current="page">{article.title}</span>
        </li>
      </ol>
    </nav>

    <header class="article-header">
      <p class="eyebrow article-section">
        {sectionTitle}
        <span aria-hidden="true"> / </span>
        {formatLabel(article.contentType)}
      </p>

      <h1>{article.title}</h1>

      <p class="article-description">
        {article.description}
      </p>

      <div class="article-metadata">
        <span class="article-byline">
          By
          <a href={`/authors/${author.id}/`}>
            {author.data.name}
          </a>
        </span>

        {article.publishedAt && (
          <span>
            Published
            <time datetime={article.publishedAt.toISOString()}>
              {formatDate(article.publishedAt)}
            </time>
          </span>
        )}

        {article.updatedAt && (
          <span>
            Updated
            <time datetime={article.updatedAt.toISOString()}>
              {formatDate(article.updatedAt)}
            </time>
          </span>
        )}

        {article.lastVerified && (
          <span>
            Last verified
            <time datetime={article.lastVerified.toISOString()}>
              {formatDate(article.lastVerified)}
            </time>
          </span>
        )}

        <span>{readingTimeMinutes} min read</span>
      </div>

      {article.tags.length > 0 && (
        <ul class="article-tags" aria-label="Article topics">
          {article.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </header>

    {(article.game ||
      article.gameVersion ||
      article.androidVersions?.length ||
      article.deviceApplicability) && (
      <dl class="article-applicability">
        {article.game && (
          <div>
            <dt>Game</dt>
            <dd>{article.game}</dd>
          </div>
        )}

        {article.gameVersion && (
          <div>
            <dt>Game version</dt>
            <dd>{article.gameVersion}</dd>
          </div>
        )}

        {article.androidVersions?.length && (
          <div>
            <dt>Android versions</dt>
            <dd>{article.androidVersions.join(", ")}</dd>
          </div>
        )}

        {article.deviceApplicability && (
          <div>
            <dt>Device applicability</dt>
            <dd>{article.deviceApplicability}</dd>
          </div>
        )}
      </dl>
    )}

    {showTableOfContents && (
      <nav class="article-toc" aria-labelledby="article-toc-heading">
        <h2 id="article-toc-heading">In this guide</h2>

        <ol>
          {tableOfContentsHeadings.map((heading) => (
            <li class={heading.depth === 3 ? "toc-subheading" : undefined}>
              <a href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <aside class="testing-disclosure">
      <strong>Testing and verification</strong>
      <p>{article.testingDisclosure}</p>
    </aside>

    <div class="article-content prose">
      <slot />
    </div>

    {article.sources.length > 0 && (
      <section class="article-sources" aria-labelledby="article-sources-heading">
        <h2 id="article-sources-heading">Sources and further reading</h2>

        <ol>
          {article.sources.map((source) => (
            <li>
              <a
                href={source}
                target="_blank"
                rel="noopener noreferrer"
              >
                {source}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {relatedArticles.length > 0 && (
      <section class="related-guides" aria-labelledby="related-guides-heading">
        <div class="related-guides-heading">
          <p class="eyebrow">Continue exploring</p>
          <h2 id="related-guides-heading">Related guides</h2>
        </div>

        <div class="related-guide-grid">
          {relatedArticles.map((relatedArticle) => (
            <a
              class="related-guide-card"
              href={`/${relatedArticle.data.section}/${relatedArticle.id}/`}
            >
              <span class="related-guide-meta">
                {relatedArticle.data.game ??
                  formatLabel(relatedArticle.data.contentType)}
              </span>

              <h3>{relatedArticle.data.title}</h3>

              <p>{relatedArticle.data.description}</p>

              <span class="related-guide-link">
                Read guide &rarr;
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</SiteLayout>

<style>
  .article-breadcrumb {
    margin-bottom: 30px;
    color: var(--color-muted);
    font-size: 0.83rem;
  }

  .article-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
  }

  .article-breadcrumb li:not(:last-child)::after {
    color: #91A0AD;
    content: "/";
  }

  .article-breadcrumb a {
    color: var(--color-teal);
    font-weight: 650;
    text-decoration: none;
  }

  .article-breadcrumb a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-breadcrumb [aria-current="page"] {
    overflow-wrap: anywhere;
    color: var(--color-muted);
  }

  .article-byline a {
    margin-left: 4px;
    color: var(--color-teal);
    font-weight: 700;
    text-decoration: none;
  }

  .article-byline a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-applicability {
    display: grid;
    gap: 14px;
    margin: 28px 0;
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
  }

  .article-applicability > div {
    display: grid;
    grid-template-columns: minmax(120px, 0.34fr) minmax(0, 1fr);
    gap: 16px;
  }

  .article-applicability dt {
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .article-applicability dd {
    margin: 0;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }

  .article-toc {
    margin-block: 30px;
    padding: 22px 24px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
  }

  .article-toc h2 {
    margin: 0;
    font-size: 1.08rem;
    letter-spacing: -0.02em;
  }

  .article-toc ol {
    display: grid;
    gap: 9px;
    margin: 16px 0 0;
    padding-left: 22px;
  }

  .article-toc li {
    padding-left: 3px;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .article-toc li::marker {
    color: var(--color-teal);
    font-weight: 700;
  }

  .article-toc .toc-subheading {
    margin-left: 18px;
    font-size: 0.88rem;
  }

  .article-toc a {
    color: var(--color-link);
    text-decoration: none;
    text-underline-offset: 3px;
  }

  .article-toc a:hover {
    color: var(--color-hover);
    text-decoration: underline;
  }

  .related-guides {
    margin-top: 54px;
    padding-top: 30px;
    border-top: 1px solid var(--color-border);
  }

  .related-guides-heading .eyebrow {
    margin-bottom: 8px;
  }

  .related-guides-heading h2 {
    margin: 0;
    font-size: 1.8rem;
    letter-spacing: -0.045em;
  }

  .related-guide-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 22px;
  }

  .related-guide-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: 21px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .related-guide-card:hover {
    border-color: var(--color-teal);
    background: #FBFCFC;
    color: var(--color-ink);
  }

  .related-guide-meta {
    color: var(--color-muted);
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .related-guide-card h3 {
    margin: 12px 0 7px;
    font-size: 1.12rem;
    letter-spacing: -0.025em;
    line-height: 1.35;
  }

  .related-guide-card p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .related-guide-link {
    margin-top: 17px;
    color: var(--color-teal);
    font-size: 0.86rem;
    font-weight: 750;
  }

  @media (max-width: 640px) {
    .article-applicability > div {
      grid-template-columns: 1fr;
      gap: 3px;
    }

    .article-toc {
      padding: 19px;
    }

    .related-guide-grid {
      grid-template-columns: 1fr;
    }
  }
</style>