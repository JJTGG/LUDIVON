---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Search | LUDIVON"
  description="Search LUDIVON's Android gaming and game-specific guides."
  indexContent={false}
>
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="/pagefind/pagefind-component-ui.css"
    />

    <script
      is:inline
      type="module"
      src="/pagefind/pagefind-component-ui.js"
    ></script>
  </Fragment>

  <section class="search-shell shell">
    <p class="eyebrow">LUDIVON / SEARCH</p>

    <h1>Find what you need.</h1>

    <p class="search-intro">
      Search practical guides, troubleshooting advice,
      Android gaming topics and game-specific information.
    </p>

    <div class="search-interface">
      <pagefind-input
        placeholder="Search articles, games and topics..."
      ></pagefind-input>

      <pagefind-summary
        default-message="Enter a topic, game or question to search."
      ></pagefind-summary>

      <pagefind-results
        max-results="10"
        show-images="false"
      ></pagefind-results>
    </div>
  </section>
</SiteLayout>