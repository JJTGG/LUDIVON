---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const articles = (
  await getCollection(
    "gameGuides",
    ({ data }) => data.status === "published"
  )
).sort(
  (a, b) =>
    (b.data.publishedAt?.getTime() ?? 0) -
    (a.data.publishedAt?.getTime() ?? 0)
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC"
  });
---

<SiteLayout
  title="Game Guides | LUDIVON"
  description="Practical, game-specific guides, settings advice, troubleshooting and gameplay help."
>
  <section class="page-heading">
    <div class="shell">
      <p class="eyebrow">LUDIVON / GAMES</p>

      <h1>Game Guides</h1>

      <p>
        Straightforward help for individual games.
        Explore useful explanations, gameplay guidance,
        settings recommendations and solutions to common problems.
      </p>
    </div>
  </section>

  <section class="shell">
    {articles.length > 0 ? (
      <div class="article-list">
        {articles.map((article) => (
          <a
            class="article-card"
            href={`/game-guides/${article.id}/`}
          >
            <span class="article-card-meta">
              {article.data.game ?? "Game guide"}

              {article.data.publishedAt && (
                <>
                  &nbsp; · &nbsp;
                  <time datetime={article.data.publishedAt.toISOString()}>
                    {formatDate(article.data.publishedAt)}
                  </time>
                </>
              )}
            </span>

            <h2>{article.data.title}</h2>

            <p>{article.data.description}</p>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <h2>The game-guide library is being prepared.</h2>

        <p>
          Game-specific guides will appear here after editorial
          review and publication.
        </p>
      </div>
    )}
  </section>
</SiteLayout>