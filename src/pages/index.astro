---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout>
  <section class="home-hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Gaming &amp; Technology Guides</p>

      <h1>
        Understand your tech.
        <span>Play smarter.</span>
      </h1>

      <p class="hero-description">
        Clear, practical guides for getting more from Android
        gaming. Understand performance, make better settings
        choices, solve problems and get back to playing.
      </p>

      <div class="hero-actions">
        <a class="button-primary" href="/android-gaming/">
          Explore Android Gaming
        </a>

        <a class="button-secondary" href="/game-guides/">
          Browse Game Guides
        </a>
      </div>
    </div>

    <aside class="feature-panel">
      <p class="eyebrow">The LUDIVON approach</p>

      <h2>Useful knowledge. Better gaming decisions.</h2>

      <p>
        Technology advice should help you understand what to do,
        why it matters and where its limitations are.
      </p>

      <ul class="feature-list">
        <li>Android gaming performance and optimisation</li>
        <li>Settings, compatibility and troubleshooting</li>
        <li>Practical guides for individual games</li>
        <li>Clear distinctions between tested facts and guidance</li>
      </ul>
    </aside>
  </section>

  <section class="content-section shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Explore the library</p>
        <h2>Find the guidance you need.</h2>
      </div>

      <p>
        Start with Android gaming fundamentals or go directly
        to practical guides for individual games.
      </p>
    </div>

    <div class="category-grid">
      <a class="category-card" href="/android-gaming/">
        <span class="category-number">01 / ANDROID</span>

        <h3>Android Gaming</h3>

        <p>
          Understand performance, device compatibility,
          settings, optimisation and common gaming problems
          on Android.
        </p>

        <span class="category-link-label">
          Explore Android Gaming &rarr;
        </span>
      </a>

      <a class="category-card" href="/game-guides/">
        <span class="category-number">02 / GAMES</span>

        <h3>Game Guides</h3>

        <p>
          Find game-specific help, practical explanations,
          gameplay guidance and settings recommendations.
        </p>

        <span class="category-link-label">
          Explore Game Guides &rarr;
        </span>
      </a>
    </div>
  </section>
</SiteLayout>