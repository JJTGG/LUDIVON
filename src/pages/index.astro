---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const [androidArticles, gameArticles] = await Promise.all([
  getCollection(
    "androidGaming",
    ({ data }) => data.status === "published"
  ),
  getCollection(
    "gameGuides",
    ({ data }) => data.status === "published"
  )
]);

const publishedArticles = [
  ...androidArticles,
  ...gameArticles
].sort((a, b) => {
  const aDate = a.data.publishedAt?.getTime() ?? 0;
  const bDate = b.data.publishedAt?.getTime() ?? 0;

  if (bDate !== aDate) {
    return bDate - aDate;
  }

  return a.data.title.localeCompare(b.data.title);
});

const latestArticles = publishedArticles.slice(0, 4);

const androidCount = androidArticles.length;
const gameCount = gameArticles.length;
const totalCount = publishedArticles.length;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC"
  });

const formatLabel = (value: string) =>
  value
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
---

<SiteLayout>
  <section class="home-intro shell">
    <div class="home-intro-copy">
      <p class="eyebrow">LUDIVON / GAMING &amp; TECHNOLOGY</p>

      <h1>
        Understand your tech.
        <span>Play smarter.</span>
      </h1>

      <p class="home-intro-description">
        Better gaming starts with understanding your device.
        Explore practical Android gaming advice, solve technical
        problems and make more informed decisions about the
        games you play.
      </p>

      <div class="home-actions">
        <a class="home-action-primary" href="/android-gaming/">
          Explore Android Gaming
          <span aria-hidden="true">→</span>
        </a>

        <a class="home-action-secondary" href="/game-guides/">
          Browse Game Guides
        </a>
      </div>

      <div class="home-intro-note">
        <span class="home-note-marker" aria-hidden="true"></span>
        <p>
          Practical guidance for budget and mid-range Android devices.
        </p>
      </div>
    </div>

    <aside class="home-editorial-panel">
      <div class="home-panel-topline">
        <span>THE LUDIVON APPROACH</span>
        <span>01 / 03</span>
      </div>

      <div class="home-panel-main">
        <p class="home-panel-overline">Not just another gaming page</p>

        <h2>
          Know what your device can do.
          Understand what it cannot.
        </h2>

        <p>
          We focus on useful explanations, realistic guidance
          and the details that make technical advice applicable
          to your actual device.
        </p>
      </div>

      <div class="home-panel-principles">
        <div>
          <span>01</span>
          <p>Understand performance</p>
        </div>

        <div>
          <span>02</span>
          <p>Make informed settings choices</p>
        </div>

        <div>
          <span>03</span>
          <p>Troubleshoot with context</p>
        </div>
      </div>

      <div class="home-panel-bottom">
        <span>INDEPENDENT PUBLICATION</span>
        <span>FROM TGG HUB</span>
      </div>
    </aside>
  </section>

  <section class="home-library-section">
    <div class="shell">
      <div class="home-section-heading">
        <div>
          <p class="eyebrow">THE LIBRARY</p>
          <h2>Guidance worth keeping.</h2>
        </div>

        <a href="/search/" class="home-text-link">
          Search LUDIVON
          <span aria-hidden="true">→</span>
        </a>
      </div>

      {latestArticles.length > 0 ? (
        <div class="home-article-grid">
          {latestArticles.map((article, index) => (
            <a
              class={`home-article-card ${index === 0 ? "home-article-card-featured" : ""}`}
              href={`/${article.data.section}/${article.id}/`}
            >
              <div class="home-article-card-top">
                <span class="home-article-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span class="home-article-section">
                  {article.data.section === "android-gaming"
                    ? "ANDROID GAMING"
                    : "GAME GUIDE"}
                </span>
              </div>

              <div class="home-article-card-content">
                <p class="home-article-type">
                  {formatLabel(article.data.contentType)}
                  {article.data.game && ` / ${article.data.game}`}
                </p>

                <h3>{article.data.title}</h3>

                <p class="home-article-description">
                  {article.data.description}
                </p>
              </div>

              <div class="home-article-card-bottom">
                {article.data.publishedAt && (
                  <time datetime={article.data.publishedAt.toISOString()}>
                    {formatDate(article.data.publishedAt)}
                  </time>
                )}

                <span class="home-article-read">
                  Read guide <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="home-library-empty">
          <div class="home-empty-index">01</div>

          <div class="home-empty-content">
            <p class="eyebrow">FIRST EDITION IN PROGRESS</p>

            <h3>The library is taking shape.</h3>

            <p>
              We are preparing the first guides. Each article
              will go through research, verification and
              editorial review before publication.
            </p>

            <a href="/editorial-standards/" class="home-text-link">
              How we prepare our guides
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="home-empty-status">
            <span class="home-status-dot"></span>
            <span>CONTENT PREPARATION</span>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="home-categories shell">
    <div class="home-section-heading">
      <div>
        <p class="eyebrow">EXPLORE BY INTEREST</p>
        <h2>Start with what you need.</h2>
      </div>

      <p class="home-section-description">
        Two focused libraries. Different questions.
        One practical approach.
      </p>
    </div>

    <div class="home-category-grid">
      <a href="/android-gaming/" class="home-category-card">
        <div class="home-category-top">
          <span class="home-category-index">01</span>
          <span class="home-category-count">
            {androidCount} {androidCount === 1 ? "GUIDE" : "GUIDES"}
          </span>
        </div>

        <div>
          <p class="home-category-kicker">YOUR DEVICE, UNDERSTOOD</p>

          <h3>Android Gaming</h3>

          <p>
            Performance, optimisation, compatibility,
            device settings and troubleshooting.
          </p>
        </div>

        <span class="home-category-link">
          Explore Android Gaming
          <span aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/game-guides/" class="home-category-card home-category-game">
        <div class="home-category-top">
          <span class="home-category-index">02</span>
          <span class="home-category-count">
            {gameCount} {gameCount === 1 ? "GUIDE" : "GUIDES"}
          </span>
        </div>

        <div>
          <p class="home-category-kicker">HELP FOR THE GAMES YOU PLAY</p>

          <h3>Game Guides</h3>

          <p>
            Game-specific tutorials, settings advice,
            walkthroughs and practical solutions.
          </p>
        </div>

        <span class="home-category-link">
          Explore Game Guides
          <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </section>

  <section class="home-trust-section">
    <div class="shell">
      <div class="home-trust-heading">
        <p class="eyebrow">OUR EDITORIAL STANDARD</p>
        <h2>Advice should be useful, honest and understandable.</h2>
      </div>

      <div class="home-trust-grid">
        <article>
          <span class="home-trust-number">01</span>
          <h3>Accuracy over hype</h3>
          <p>
            Technical claims should have evidence.
            We do not present guesses as verified results.
          </p>
        </article>

        <article>
          <span class="home-trust-number">02</span>
          <h3>Context matters</h3>
          <p>
            Device, Android and game-version limitations
            should be clear wherever they affect advice.
          </p>
        </article>

        <article>
          <span class="home-trust-number">03</span>
          <h3>Corrections are welcome</h3>
          <p>
            Information can become outdated.
            Material errors should be corrected transparently.
          </p>
        </article>
      </div>

      <div class="home-trust-footer">
        <a href="/editorial-standards/" class="home-text-link">
          Read our editorial standards
          <span aria-hidden="true">→</span>
        </a>

        <a href="/corrections/" class="home-text-link">
          Report an issue
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="home-closing shell">
    <div>
      <p class="eyebrow">KEEP EXPLORING</p>
      <h2>Find a better way to understand your tech.</h2>
    </div>

    <div class="home-closing-actions">
      <a class="home-action-primary" href="/search/">
        Search the library
        <span aria-hidden="true">→</span>
      </a>

      <a class="home-action-secondary" href="/about/">
        About LUDIVON
      </a>
    </div>
  </section>
</SiteLayout>

