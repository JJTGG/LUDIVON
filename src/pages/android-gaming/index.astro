---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const articles = (
  await getCollection(
    "androidGaming",
    ({ data }) => data.status === "published"
  )
).sort(
  (a, b) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
---

<SiteLayout
  title="Android Gaming Guides | LUDIVON"
  description="Practical Android gaming guides covering performance, optimisation, settings, compatibility and troubleshooting."
>
  <section class="page-heading">
    <div class="shell">
      <p class="eyebrow">LUDIVON / ANDROID</p>

      <h1>Android Gaming</h1>

      <p>
        Understand how Android devices handle games.
        Find practical guidance on performance, settings,
        optimisation, compatibility and troubleshooting.
      </p>
    </div>
  </section>

  <section class="shell">
    {articles.length > 0 ? (
      <div class="article-list">
        {articles.map((article) => (
          <a
            class="article-card"
            href={`/android-gaming/${article.id}/`}
          >
            <span class="article-card-meta">
              {article.data.contentType}
              &nbsp; · &nbsp;
              {article.data.publishedAt.toLocaleDateString("en", {
                day: "numeric",
                month: "long",
                year: "numeric"
              })}
            </span>

            <h2>{article.data.title}</h2>

            <p>{article.data.description}</p>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <h2>The Android gaming library is being prepared.</h2>

        <p>
          Guides will appear here after editorial review
          and publication.
        </p>
      </div>
    )}
  </section>
</SiteLayout>